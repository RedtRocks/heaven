# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://keepsake:keepsake@127.0.0.1:5433/keepsake

# LLM: "gemini" or "openai" (openai also covers OpenRouter via OPENAI_BASE_URL)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-nano

# Speech-to-text: Groq Whisper (free plan)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Face rendering: "still" (cheap, needs ffmpeg + likeness/face/photo.jpg) or
# "musetalk_kaggle" (MuseTalk on a free Kaggle GPU, needs everything below).
# See docs/notes/face-musetalk.md and docs/agents/reports/musetalk.md.
FACE_PROVIDER=still
FFMPEG_PATH=ffmpeg

# Kaggle API token: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
# "<kaggle-username>/keepsake-musetalk" kernel pushed from notebooks/musetalk_kaggle/
KAGGLE_KERNEL_ID=
# "<kaggle-username>/keepsake-face-jobs" private dataset the provider pushes WAVs to
KAGGLE_JOBS_DATASET_ID=
KAGGLE_POLL_INTERVAL_SECONDS=15
KAGGLE_TIMEOUT_SECONDS=1800

# Warm the voice model at startup (needs `uv sync --extra voice`)
VOICE_WARMUP=0
VOICE_THREADS=6
