# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://keepsake:keepsake@127.0.0.1:5433/keepsake

# LLM: "gemini" or "openai" (openai also covers OpenRouter via OPENAI_BASE_URL)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-nano

# Speech-to-text: Groq Whisper (free plan)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
